# Copy to .env.local and fill in.

# Anthropic API key (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=

# The Postgres database the agent works on. Prefer a dedicated role (see README).
# Hosted databases (Render, Supabase, Neon, ...): use the provider's *external*
# URL and add ?sslmode=verify-full (or ?sslmode=no-verify if the certificate
# check fails), e.g. postgresql://user:pass@host.render.com/db?sslmode=verify-full
DATABASE_URL=postgres://agent:agent@localhost:5432/shop

# Login for the app (HTTP Basic auth). Required in production (`pnpm start`):
# without it the app answers 503. Password: at least 12 characters.
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=
# Or run production without a login (only on a private network):
# AUTH_DISABLED=true

# Optional: a separate, read-only connection for SELECTs and schema introspection.
# DATABASE_URL_READONLY=postgres://agent_ro:secret@localhost:5432/shop

# Optional tuning (defaults shown).
# ANTHROPIC_MODEL=claude-opus-5
# MAX_SELECT_ROWS=200
# MAX_RESULT_BYTES=50000
# MAX_WRITE_ROWS=100
# STATEMENT_TIMEOUT_MS=10000
# MAX_TOOL_ITERATIONS=15
# AUDIT_LOG_PATH=logs/audit.jsonl

# Only for `pnpm test`: a throwaway database. The tests drop and reload the demo tables in it.
# TEST_DATABASE_URL=postgres://agent:agent@localhost:5432/shop_test
